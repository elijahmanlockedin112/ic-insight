{
  "manifest_version": 3,
  "name": "IC Insight — Grade Coach",
  "version": "0.1.0",
  "description": "Reads your own Infinite Campus grades, schedule and transcript locally, computes trends, and coaches you toward your goal using an AI model of your choice.",
  "minimum_chrome_version": "116",

  "permissions": ["storage", "unlimitedStorage", "scripting"],

  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],

  "optional_host_permissions": ["*://*/*"],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "IC Insight",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_page": "src/ui/options.html",

  "content_scripts": [
    {
      "matches": ["*://*.infinitecampus.org/*"],
      "js": ["src/content/interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.infinitecampus.org/*"],
      "js": ["src/content/bridge.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/ui/dashboard.html"],
      "matches": ["*://*.infinitecampus.org/*"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
