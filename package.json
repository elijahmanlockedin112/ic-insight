{
  "name": "ic-insight",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that reads your own Infinite Campus grades, computes trends locally, and coaches you toward a goal using an AI model of your choice.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "icons": "node tools/make-icons.mjs",
    "check": "node tools/check.mjs",
    "build": "node tools/build-zip.mjs",
    "verify": "npm run check && npm test"
  },
  "keywords": [
    "chrome-extension",
    "infinite-campus",
    "grades",
    "manifest-v3"
  ]
}
